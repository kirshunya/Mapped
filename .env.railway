# Railway Configuration
# Скопируйте в .env перед деплоем на Railway

# Database
DB_USER=mapsocial
DB_PASSWORD=change_this_in_production
DB_NAME=mapsocial

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# MinIO (если используете MinIO)
MINIO_USER=minioadmin
MINIO_PASSWORD=change_this_in_production

# Frontend API URL
# Railway автоматически создаст URL для gateway, замените на реальный
REACT_APP_API_URL=https://your-gateway-url.railway.app/api

# Media Service URL
MEDIA_PUBLIC_URL=https://your-media-service-url.railway.app/media
