# Railway Production Environment Variables
# Copy these to Railway Dashboard → Project Settings → Variables

# ===== DATABASE CONFIGURATION =====
DB_USER=mapsocial
DB_PASSWORD=RailwayProd2024!SecurePass123
DB_NAME=mapped_db
DATABASE_URL=postgresql://mapsocial:RailwayProd2024!SecurePass123@postgres:5432/mapped_db

# ===== JWT CONFIGURATION =====
JWT_SECRET=railway-production-secret-key-32-chars-min-8e9f7a2b4c5d6e9f0a1b2c3d4e5f6g7h
JWT_EXPIRY=720h

# ===== SERVICE URLS (Railway Internal Network) =====
# These services communicate via Docker internal network on Railway
AUTH_SERVICE_URL=http://auth-service:8081
PLACES_SERVICE_URL=http://places-service:8082
REVIEWS_SERVICE_URL=http://reviews-service:8083
MEDIA_SERVICE_URL=http://media-service:8084
POSTS_SERVICE_URL=http://posts-service:8085
CHAT_SERVICE_URL=http://chat-service:8086

# ===== PORT CONFIGURATION =====
PORT=8080
GATEWAY_PORT=8080

# ===== FRONTEND CONFIGURATION =====
# Update this after you get the Railway public domain
REACT_APP_API_URL=https://your-railway-domain.up.railway.app/api/v1

# ===== KAFKA & MESSAGING (DISABLED FOR HOBBY PLAN) =====
KAFKA_ENABLED=false
KAFKA_BROKERS=

# ===== FILE STORAGE (DISABLED - Using local storage) =====
MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
